# Copy file này thành ".env" và điền giá trị thật (KHÔNG commit file .env lên GitHub)

PORT=3000

# Số VA nhận thanh toán (KHÔNG dùng số tài khoản chính)
SEPAY_VA_ACCOUNT=96247GLOBALEXPORT5
SEPAY_BANK=BIDV

# API Token lấy từ my.sepay.vn/companyapi (dùng để gọi API Sepay nếu cần sau này)
SEPAY_API_TOKEN=

# Khoá bí mật TỰ ĐẶT khi tạo Webhook trong my.sepay.vn/webhooks (chọn xác thực "API Key")
# Đây KHÔNG phải SEPAY_API_TOKEN — là 1 chuỗi bạn tự nghĩ ra, dùng để Sepay "chứng minh"
# đúng là Sepay đang gọi webhook của bạn.
SEPAY_WEBHOOK_KEY=
